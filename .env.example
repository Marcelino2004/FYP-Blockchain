# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Blockchain Configuration
NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CONFIRMATIONS=1

# For Sepolia testnet:
# NETWORK=sepolia
# RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
